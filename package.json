{
  "name": "applyguruofficial",
  "version": "1.0.0",
  "private": true,
  "description": "A premium government services information portal built with Next.js 15 (App Router), TypeScript and Tailwind CSS.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
